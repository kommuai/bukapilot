Import('env', 'arch', 'messaging', 'common', 'visionipc', 'device')
if device == 'KA2':
  env.Append(CPPPATH=['/usr/include/rkaiq', '/usr/include/rkaiq/algos', '/usr/include/rkaiq/iq_parser', '/usr/include/rkaiq/smartIr', '/usr/include/rkaiq/common', '/usr/include/rkaiq/iq_parser_v2', '/usr/include/rkaiq/isp', '/usr/include/rkaiq/ipc_server', '/usr/include/rkaiq/uAPI2', '/usr/include/rkaiq/xcore', '/usr/include/rkaiq/algos/aynr2', '/usr/include/rkaiq/algos/anr', '/usr/include/rkaiq/algos/adehaze', '/usr/include/rkaiq/algos/aldch', '/usr/include/rkaiq/algos/accm', '/usr/include/rkaiq/algos/again2', '/usr/include/rkaiq/algos/amd', '/usr/include/rkaiq/algos/afec', '/usr/include/rkaiq/algos/auvnr', '/usr/include/rkaiq/algos/aynr3', '/usr/include/rkaiq/algos/acp', '/usr/include/rkaiq/algos/asd', '/usr/include/rkaiq/algos/argbir', '/usr/include/rkaiq/algos/a3dlut', '/usr/include/rkaiq/algos/acnr2', '/usr/include/rkaiq/algos/agamma', '/usr/include/rkaiq/algos/acgc', '/usr/include/rkaiq/algos/acnrV30', '/usr/include/rkaiq/algos/ablcV32', '/usr/include/rkaiq/algos/asharpV33', '/usr/include/rkaiq/algos/atmo', '/usr/include/rkaiq/algos/adegamma', '/usr/include/rkaiq/algos/asharp', '/usr/include/rkaiq/algos/aie', '/usr/include/rkaiq/algos/arawnr2', '/usr/include/rkaiq/algos/amfnr', '/usr/include/rkaiq/algos/acac', '/usr/include/rkaiq/algos/acnr', '/usr/include/rkaiq/algos/alsc', '/usr/include/rkaiq/algos/aeis', '/usr/include/rkaiq/algos/adebayer', '/usr/include/rkaiq/algos/arawnr', '/usr/include/rkaiq/algos/agic', '/usr/include/rkaiq/algos/abayertnrV23', '/usr/include/rkaiq/algos/adpcc', '/usr/include/rkaiq/algos/asharp3', '/usr/include/rkaiq/algos/aorb', '/usr/include/rkaiq/algos/again', '/usr/include/rkaiq/algos/amerge', '/usr/include/rkaiq/algos/adrc', '/usr/include/rkaiq/algos/abayertnrV30', '/usr/include/rkaiq/algos/awb', '/usr/include/rkaiq/algos/asharp4', '/usr/include/rkaiq/algos/asharpV34', '/usr/include/rkaiq/algos/aynrV24', '/usr/include/rkaiq/algos/ae', '/usr/include/rkaiq/algos/ablc', '/usr/include/rkaiq/algos/abayer2dnr2', '/usr/include/rkaiq/algos/a