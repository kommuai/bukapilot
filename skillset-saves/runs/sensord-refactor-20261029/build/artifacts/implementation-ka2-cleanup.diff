+def test_sensord_enabled_only_for_ka2_and_stays_onroad(monkeypatch):
+  from importlib import reload
+  import openpilot.system.hardware as hardware
+  import openpilot.system.manager.process_config as process_config
+
+  actual_ka2 = hardware.KA2
+  try:
+    for is_ka2 in (False, True):
+      monkeypatch.setattr(hardware, "KA2", is_ka2)
+      process_config = reload(process_config)
+      sensord = process_config.managed_processes["sensord"]
+
+      assert sensord.enabled is is_ka2
+      assert sensord.should_run(False, None, None) is False
+      assert sensord.should_run(True, None, None) is True
+  finally:
+    monkeypatch.setattr(hardware, "KA2", actual_ka2)
+    reload(process_config)
+
+
 class TestManager:
   def setup_method(self):
     HARDWARE.set_power_save(False)
