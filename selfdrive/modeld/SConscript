import os
import glob

Import('env', 'envCython', 'arch', 'device', 'cereal', 'messaging', 'common', 'visionipc')
lenv = env.Clone()
lenvCython = envCython.Clone()
# Tinygrad compile (tg_compile) uses DEV=CL when building for larch64 non-KA2. KA2 uses RKNN only (no tg_compile).
if arch == 'larch64' and device != 'KA2':
  lenv['ENV']['DEV'] = 'CL'

try:
  pc_thneed = GetOption('pc_thneed')
except (AttributeError, TypeError):
  pc_thneed = False

libs = [cereal, messaging, visionipc, common, 'capnp', 'zmq', 'kj', 'pthread']
frameworks = []

common_src = [
  "models/commonmodel.cc",
  "transforms/loadyuv.cc",
  "transforms/transform.cc",
]

if device == 'TICI' or device == 'KA2':
  thneed_src_common = [
    "thneed/thneed_common.cc",
    "thneed/serialize.cc",
  ]

  thneed_src_qcom = thneed_src_common + ["thneed/thneed_qcom2.cc"]
  thneed_src_pc = thneed_src_common + ["thneed/thneed_pc.cc"]
  thneed_src = thneed_src_qcom if (arch == "larch64" and device != 'KA2') else thneed_src_pc

# SNPE except on Mac and ARM Linux
snpe_lib = []
if device == 'TICI':
  common_src += ['runners/snpemodel.cc']
  snpe_lib += ['SNPE']

rknn_lib = []
if device == 'KA2':
  rknn_lib += ['rknnrt']
  common_src += ['runners/rknnmodel.cc']

# OpenCL is a framework on Mac
if arch == "Darwin":
  frameworks += ['OpenCL']
else:
  libs += ['OpenCL']

# Set path definitions
for pathdef, fn in {'TRANSFORM': 'transforms/transform.cl', \
                    'LOADYUV': 'transforms/loadyuv.cl'}.items():
  for xenv in (lenv, lenvCython):
    xenv['CXXFLAGS'].append(f'-D{pathdef}_PATH=\\\"/data/openpilot/selfdrive/modeld/{fn}\\\"')

# Compile cython
cython_libs = envCython["LIBS"] + libs
commonmodel_lib = lenv.Library('commonmodel', common_src)

lenvCython.Program('runners/runmodel_pyx.so', 'runners/runmodel_pyx.pyx', LIBS=cython_libs, FRAMEWORKS=frameworks)
if device == 'TICI':
  snpe_rpath_qcom = "/data/pythonpath/third_party/snpe/larch64"
  snpe_rpath_pc = f"{Dir('#').abspath}/third_party/snpe/x86_64-linux-clang"
  snpe_rpath = lenvCython['RPATH'] + [snpe_rpath_qcom if device == 'TICI' else snpe_rpath_pc]
  snpemodel_lib = lenv.Library('snpemodel', ['runners/snpemodel.cc'])
  lenvCython.Program('runners/snpemodel_pyx.so', 'runners/snpemodel_pyx.pyx', LIBS=[snpemodel_lib, snpe_lib, *cython_libs], FRAMEWORKS=frameworks, RPATH=snpe_rpath)
if device == 'KA2' and arch == "larch64":
  rknnmodel_lib = lenv.Library('rknnmodel', ['runners/rknnmodel.cc'])
  lenvCython.Program('runners/rknnmodel_pyx.so', 'runners/rknnmodel_pyx.pyx', LIBS=[rknnmodel_lib, rknn_lib, *cython_libs], FRAMEWORKS=frameworks, RPATH=f"{Dir('#').abspath}/third_party/rknpu/aarch64")
  driving_rknn_lib = lenv.Library('driving_rknnmodel', ['runners/driving_rknnmodel.cc'])
  lenvCython.Program('runners/driving_rknnmodel_pyx.so', 'runners/driving_rknnmodel_pyx.pyx', LIBS=[driving_rknn_lib, rknn_lib, *cython_libs], FRAMEWORKS=frameworks, RPATH=f"{Dir('#').abspath}/third_party/rknpu/aarch64")
  dmonitoring_rknn_lib = lenv.Library('dmonitoring_rknnmodel', ['runners/dmonitoring_rknnmodel.cc'])
  lenvCython.Program('runners/dmonitoring_rknnmodel_pyx.so', 'runners/dmonitoring_rknnmodel_pyx.pyx', LIBS=[dmonitoring_rknn_lib, rknn_lib, *cython_libs], FRAMEWORKS=frameworks, RPATH=f"{Dir('#').abspath}/third_party/rknpu/aarch64")
lenvCython.Program('models/commonmodel_pyx.so', 'models/commonmodel_pyx.pyx', LIBS=[commonmodel_lib, *cython_libs], FRAMEWORKS=frameworks)

tinygrad_files = ["#"+x for x in glob.glob(env.Dir("#tinygrad_repo").relpath + "/**", recursive=True, root_dir=env.Dir("#").abspath) if 'pycache' not in x]

# Get model metadata (tinygrad models)
for model_name in ['driving_vision', 'driving_policy', 'dmonitoring_model']:
  fn = File(f"models/{model_name}").abspath
  script_files = [File(Dir("#selfdrive/modeld").File("get_model_metadata.py").abspath)]
  cmd = f'python3 {Dir("#selfdrive/modeld").abspath}/get_model_metadata.py {fn}.onnx'
  lenv.Command(fn + "_metadata.pkl", [fn + ".onnx"] + tinygrad_files + script_files, cmd)

# Get model metadata (supercombo for thneed) - only when supercombo.onnx exists
fn_supercombo = File("models/supercombo").abspath
if os.path.exists(fn_supercombo + ".onnx"):
  try:
    _files_common_lines = open(File("#release/files_common").abspath).read().split("\n")
  except FileNotFoundError:
    _files_common_lines = ["selfdrive/modeld/get_model_metadata.py"]
  files = sum([lenv.Glob("#"+x) for x in _files_common_lines if x.endswith("get_model_metadata.py")], [])
  lenv.Command(fn_supercombo + "_metadata.pkl", [fn_supercombo + ".onnx"] + files, f'python3 {Dir("#selfdrive/modeld").abspath}/get_model_metadata.py {fn_supercombo}.onnx')

def tg_compile(flags, model_name):
  pythonpath_string = 'PYTHONPATH="${PYTHONPATH}:' + env.Dir("#tinygrad_repo").abspath + '"'
  fn = File(f"models/{model_name}").abspath
  return lenv.Command(
    fn + "_tinygrad.pkl",
    [fn + ".onnx"] + tinygrad_files,
    f'{pythonpath_string} {flags} python3 {Dir("#tinygrad_repo").abspath}/examples/openpilot/compile3.py {fn}.onnx {fn}_tinygrad.pkl'
  )

# Compile small models (tinygrad). Keep KA2 tinygrad/OpenCL artifacts optional via env flag.
# Performance tune (main-repo only): defaults for larch64. Override with VISION_JITBEAM=0, etc.
force_ka2_tinygrad = os.environ.get('FORCE_KA2_TINYGRAD', '0') == '1'
if device != 'KA2' or force_ka2_tinygrad:
  _vision_jit_batch = os.environ.get('VISION_JIT_BATCH_SIZE', '0')
  _vision_nolocals = os.environ.get('VISION_NOLOCALS', '1')
  _vision_beam_local = os.environ.get('VISION_BEAM_LOCAL_MAX', '')
  _vision_mali_local_small = os.environ.get('VISION_MALI_LOCAL_SMALL', '0')
  _mali_profile = os.environ.get('MALI_PROFILE', '0')
  _vision_jitbeam = os.environ.get('VISION_JITBEAM', '0')  # BEAM at capture for vision (Tier 1 tune)
  _policy_image = os.environ.get('POLICY_IMAGE', '1')
  _vision_image = os.environ.get('VISION_IMAGE', '1')
  _vision_wino = os.environ.get('VISION_WINO', '1' if os.environ.get('VISION_IMAGE') == '0' else '0')
  for model_name in ['driving_vision', 'driving_policy', 'dmonitoring_model']:
    flags = {
      'larch64': 'DEV=CL FLOAT16=1 NOLOCALS=1 IMAGE=2 JIT_BATCH_SIZE=0',
      'Darwin': f'DEV=CPU HOME={os.path.expanduser("~")}',
    }.get(arch, 'DEV=CPU CPU_LLVM=1')
    if (arch == 'larch64') and model_name == 'driving_vision':
      _img = '0' if _vision_image == '0' else '2'
      flags = f'DEV=CL FLOAT16=1 NOLOCALS={_vision_nolocals} IMAGE={_img} JIT_BATCH_SIZE={_vision_jit_batch}'
      if _vision_wino == '1':
        flags += ' WINO=1'
      if _vision_jitbeam in ('1', '2'):
        flags += f' JITBEAM={_vision_jitbeam}'
      if _vision_beam_local:
        flags += f' BEAM_LOCAL_MAX={_vision_beam_local}'
      if _vision_mali_local_small == '1':
        flags += ' MALI_LOCAL_SMALL=1'
      if _mali_profile == '1':
        flags += ' MALI_PROFILE=1'
    if (arch == 'larch64') and model_name == 'driving_policy' and _policy_image == '0':
      flags = f'DEV=CL FLOAT16=1 NOLOCALS=1 IMAGE=0 JIT_BATCH_SIZE=0'
    tg_compile(flags, model_name)

# Build thneed model (supercombo) for TICI / pc_thneed only. KA2 uses RKNN, not thneed.
if (device == 'TICI' or pc_thneed) and os.path.exists(fn_supercombo + ".onnx"):
  # Define thneed_src for PC when only pc_thneed is set (device not TICI/KA2)
  if pc_thneed and device != 'TICI' and device != 'KA2':
    thneed_src_common = ["thneed/thneed_common.cc", "thneed/serialize.cc"]
    thneed_src = thneed_src_common + ["thneed/thneed_pc.cc"]
  tinygrad_opts = []
  if not pc_thneed:
    tinygrad_opts += ["FLOAT16=1", "PYOPENCL_NO_CACHE=1"]
  cmd = f"cd {Dir('#').abspath}/tinygrad_repo && " + ' '.join(tinygrad_opts) + f" python openpilot/compile2.py {fn_supercombo}.onnx {fn_supercombo}.thneed"

  try:
    _tinygrad_lines = open(File("#release/files_common").abspath).read().split("\n")
  except FileNotFoundError:
    _tinygrad_lines = []
  tinygrad_files_thneed = sum([lenv.Glob("#"+x) for x in _tinygrad_lines if x.startswith("tinygrad_repo/")], [])
  lenv.Command(fn_supercombo + ".thneed", [fn_supercombo + ".onnx"] + tinygrad_files_thneed, cmd)

  thneed_lib = env.SharedLibrary('thneed', thneed_src, LIBS=[common, 'zmq', 'OpenCL', 'dl'])
  thneedmodel_lib = env.Library('thneedmodel', ['runners/thneedmodel.cc'])
  lenvCython.Program('runners/thneedmodel_pyx.so', 'runners/thneedmodel_pyx.pyx', LIBS=envCython["LIBS"]+[thneedmodel_lib, thneed_lib, common, 'dl', 'zmq', 'OpenCL'])

# Compile BIG model if USB GPU is available
if "USBGPU" in os.environ:
  import subprocess
  devs = subprocess.check_output('python3 -c "from tinygrad import Device; print(list(Device.get_available_devices()))"', shell=True, cwd=env.Dir('#').abspath)
  if b"AMD" in devs:
    print("USB GPU detected... building")
    flags = "DEV=AMD AMD_IFACE=USB AMD_LLVM=1 NOLOCALS=0 IMAGE=0"
    bp = tg_compile(flags, "big_driving_policy")
    bv = tg_compile(flags, "big_driving_vision")
    lenv.SideEffect('lock', [bp, bv])
  else:
    print("USB GPU not detected... skipping")
