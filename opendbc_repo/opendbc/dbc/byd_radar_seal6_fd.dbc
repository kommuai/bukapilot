VERSION ""

# BYD Seal 6 front radar (CAN-FD bus 1).
# Replay-calibrated layout for 16 messages at 0x670..0x67f, 64 bytes each.
# Each message contains two coherent object records; record 2 starts 136 bits after record 1.
