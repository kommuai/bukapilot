#!/data/openpilot/opendbc_repo/.venv/bin/python
# -*- coding: utf-8 -*-
import sys
from cppcheck import _run
if __name__ == "__main__":
    if sys.argv[0].endswith("-script.pyw"):
        sys.argv[0] = sys.argv[0][:-11]
    elif sys.argv[0].endswith(".exe"):
        sys.argv[0] = sys.argv[0][:-4]
    sys.exit(_run())
