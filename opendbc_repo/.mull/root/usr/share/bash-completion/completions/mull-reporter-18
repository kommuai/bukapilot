_mull-reporter-18() {
    local i cur prev opts cmd
    COMPREPLY=()
    if [[ "${BASH_VERSINFO[0]}" -ge 4 ]]; then
        cur="$2"
    else
        cur="${COMP_WORDS[COMP_CWORD]}"
    fi
    prev="$3"
    cmd=""
    opts=""

    for i in "${COMP_WORDS[@]:0:COMP_CWORD}"
    do
        case "${cmd},${i}" in
            ",$1")
                cmd="mull__reporter"
                ;;
            *)
                ;;
        esac
    done

    case "${cmd}" in
        mull__reporter)
            opts="-h -V --reporters --report-dir --report-name --report-patch-base --ide-reporter-show-killed --debug --strict --allow-surviving --mutation-score-threshold --no-test-output --no-mutant-output --no-output --sqlite-busy-timeout --help --version <SQLITE-REPORT>"
            if [[ ${cur} == -* || ${COMP_CWORD} -eq 1 ]] ; then
                COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
                return 0
            fi
            case "${prev}" in
                --reporters)
                    COMPREPLY=($(compgen -W "IDE SQLite GitHubAnnotations Patches Elements Sarif" -- "${cur}"))
                    return 0
                    ;;
                --report-dir)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                --report-name)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                --report-patch-base)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                --mutation-score-threshold)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                --sqlite-busy-timeout)
                    COMPREPLY=($(compgen -f "${cur}"))
                    return 0
                    ;;
                *)
                    COMPREPLY=()
                    ;;
            esac
            COMPREPLY=( $(compgen -W "${opts}" -- "${cur}") )
            return 0
            ;;
    esac
}

if [[ "${BASH_VERSINFO[0]}" -eq 4 && "${BASH_VERSINFO[1]}" -ge 4 || "${BASH_VERSINFO[0]}" -gt 4 ]]; then
    complete -F _mull-reporter-18 -o nosort -o bashdefault -o default mull-reporter-18
else
    complete -F _mull-reporter-18 -o bashdefault -o default mull-reporter-18
fi
